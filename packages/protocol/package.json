{
  "name": "@barter.game/protocol",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "description": "Canonical JSON (JCS), ed25519 signing, doc types, and validators for the barter.game federated mutual-credit protocol. Consumed as TypeScript source; no build step. Runs identically under Bun, Node.js, and browser.",
  "keywords": [
    "mutual-credit",
    "federated",
    "ledger",
    "ed25519",
    "canonical-json",
    "jcs",
    "barter"
  ],
  "homepage": "https://docs.barter.game",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mitek99/barter.game.git",
    "directory": "packages/protocol"
  },
  "bugs": "https://github.com/Mitek99/barter.game/issues",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "echo 'No build step — source is consumed directly as TypeScript modules'",
    "prepublishOnly": "bun test"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}

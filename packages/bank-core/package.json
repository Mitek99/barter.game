{
  "name": "@barter.game/bank-core",
  "version": "0.0.4",
  "license": "MIT",
  "type": "module",
  "description": "Runtime-agnostic bank engine for the barter.game federated mutual-credit ledger (routing, RPC, advance engine, storage seams). Consumed as TypeScript source; no build step (same policy as @barter.game/protocol). Web-standard APIs only; the host injects storage.",
  "keywords": [
    "mutual-credit",
    "federated",
    "ledger",
    "bank",
    "barter"
  ],
  "homepage": "https://docs.barter.game",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mitek99/barter.game.git",
    "directory": "packages/bank-core"
  },
  "bugs": "https://github.com/Mitek99/barter.game/issues",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testkit": "./src/testkit.ts"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "echo 'no build: consumed as TS source'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@barter.game/protocol": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}

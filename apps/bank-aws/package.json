{
  "name": "@barter.game/bank-aws",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "AWS serverless host for the shared bank engine: Node.js Lambda (Function URL) + DynamoDB single-table + S3 media/static, fronted by CloudFront, deployed with SAM.",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "local": "node --import tsx src/local-server.ts",
    "deploy": "./deploy.sh"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@barter.game/bank-core": "workspace:*",
    "@barter.game/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
